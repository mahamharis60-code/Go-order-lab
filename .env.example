# Local learning mode: SQLite + in-process channel worker.
ORDER_HTTP_ADDR=:8090
ORDER_DB_DRIVER=sqlite
ORDER_DB_SOURCE=data/order_lab.db
ORDER_DB_MAX_OPEN_CONNS=30
ORDER_DB_MAX_IDLE_CONNS=15
ORDER_DB_CONN_MAX_LIFETIME_SECONDS=300
ORDER_REQUEST_TIMEOUT_SECONDS=5
ORDER_SHUTDOWN_TIMEOUT_SECONDS=10
ORDER_JWT_SECRET=dev-order-lab-secret
ORDER_ADMIN_USERNAME=admin
ORDER_ADMIN_PASSWORD=admin123456
ORDER_WORKER_COUNT=2

# Redis is disabled by default for local learning mode.
ORDER_REDIS_ENABLED=false
ORDER_REDIS_ADDR=127.0.0.1:6379
ORDER_REDIS_PASSWORD=
ORDER_REDIS_DB=0

# RabbitMQ is disabled by default for local learning mode.
ORDER_RABBITMQ_ENABLED=false
ORDER_RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
ORDER_RABBITMQ_QUEUE=order.created
ORDER_RABBITMQ_MAX_RETRIES=3

# Compensation worker is disabled by default; use /api/ops/compensate manually in smoke tests.
ORDER_COMPENSATION_ENABLED=false
ORDER_COMPENSATION_INTERVAL_SECONDS=60
ORDER_COMPENSATION_QUEUED_TIMEOUT_SECONDS=30
ORDER_COMPENSATION_PAY_TIMEOUT_SECONDS=900

# Single-process token-bucket limiter for POST /api/orders.
ORDER_RATE_LIMIT_ENABLED=false
ORDER_RATE_LIMIT_RPS=20
ORDER_RATE_LIMIT_BURST=40
