# Public HTTP port
ORDER_APP_PORT=8090

# Optional localhost ports for middleware inspection
ORDER_MYSQL_PORT=3306
ORDER_REDIS_PORT=6379
ORDER_RABBITMQ_PORT=5672
ORDER_RABBITMQ_MANAGEMENT_PORT=15672

# MySQL
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=order_lab
MYSQL_USER=order_user
MYSQL_PASSWORD=change-this-database-password

# RabbitMQ
RABBITMQ_DEFAULT_USER=order_user
RABBITMQ_DEFAULT_PASS=change-this-rabbitmq-password

# Application
ORDER_JWT_SECRET=change-this-jwt-secret
ORDER_ADMIN_USERNAME=admin
ORDER_ADMIN_PASSWORD=change-this-admin-password
ORDER_WORKER_COUNT=3
ORDER_RABBITMQ_MAX_RETRIES=3

# Background compensation
ORDER_COMPENSATION_ENABLED=false
ORDER_COMPENSATION_INTERVAL_SECONDS=60
ORDER_COMPENSATION_QUEUED_TIMEOUT_SECONDS=30
ORDER_COMPENSATION_PAY_TIMEOUT_SECONDS=900

# Single-instance token bucket for POST /api/orders
ORDER_RATE_LIMIT_ENABLED=false
ORDER_RATE_LIMIT_RPS=20
ORDER_RATE_LIMIT_BURST=40
