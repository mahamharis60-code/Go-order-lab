# Cloud deployment mode. Copy this file to .env on the server.
ORDER_APP_PORT=8090

MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=order_lab
MYSQL_USER=order_user
MYSQL_PASSWORD=change-order-password

ORDER_DB_SOURCE=order_user:change-order-password@tcp(mysql:3306)/order_lab?charset=utf8mb4&parseTime=True&loc=Local
ORDER_DB_MAX_OPEN_CONNS=30
ORDER_DB_MAX_IDLE_CONNS=15
ORDER_DB_CONN_MAX_LIFETIME_SECONDS=300

ORDER_REQUEST_TIMEOUT_SECONDS=5
ORDER_SHUTDOWN_TIMEOUT_SECONDS=10
ORDER_JWT_SECRET=change-jwt-secret
ORDER_ADMIN_USERNAME=admin
ORDER_ADMIN_PASSWORD=change-admin-password
ORDER_WORKER_COUNT=3

ORDER_REDIS_ENABLED=true
ORDER_REDIS_ADDR=redis:6379
ORDER_REDIS_PASSWORD=
ORDER_REDIS_DB=0

RABBITMQ_DEFAULT_USER=order_user
RABBITMQ_DEFAULT_PASS=change-rabbit-password
ORDER_RABBITMQ_ENABLED=true
ORDER_RABBITMQ_URL=amqp://order_user:change-rabbit-password@rabbitmq:5672/
ORDER_RABBITMQ_QUEUE=order.created
ORDER_RABBITMQ_MAX_RETRIES=3

ORDER_COMPENSATION_ENABLED=false
ORDER_COMPENSATION_INTERVAL_SECONDS=60
ORDER_COMPENSATION_QUEUED_TIMEOUT_SECONDS=30
ORDER_COMPENSATION_PAY_TIMEOUT_SECONDS=900

ORDER_RATE_LIMIT_ENABLED=false
ORDER_RATE_LIMIT_RPS=20
ORDER_RATE_LIMIT_BURST=40
